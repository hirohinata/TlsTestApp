        <mxCell id="cWpNXe89lP9ocWQLXMfx-24" value="関数は、&lt;div&gt;1. 自分の子要素を左から&lt;/div&gt;&lt;div&gt;　順に評価して&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;積む&lt;/span&gt;&lt;/div&gt;&lt;div&gt;2.&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;自分の演算を積む&lt;/span&gt;&lt;/div&gt;&lt;div&gt;の順で処理するので、&lt;/div&gt;&lt;div&gt;まずは処理を左に移動。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="cWpNXe89lP9ocWQLXMfx-1">
          <mxGeometry x="40" y="680" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cWpNXe89lP9ocWQLXMfx-25" value="１．" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=0" vertex="1" parent="cWpNXe89lP9ocWQLXMfx-1">
          <mxGeometry y="430" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cWpNXe89lP9ocWQLXMfx-37" value="[CODE]" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;" vertex="1" parent="cWpNXe89lP9ocWQLXMfx-1">
          <mxGeometry x="340" y="480" width="90" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cWpNXe89lP9ocWQLXMfx-123" value="関数は子要素を複数（引数分）&lt;div&gt;持つ。&lt;/div&gt;&lt;div&gt;変数（センサ値）は自身の要素と&lt;/div&gt;&lt;div&gt;して変数名を持つ。&lt;/div&gt;&lt;div&gt;PI（円周率）も独自の要素となる。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="cWpNXe89lP9ocWQLXMfx-1">
