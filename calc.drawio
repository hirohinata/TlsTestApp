        <mxCell id="G65QBH3iloMr4Mf4ziV6-128" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;" edge="1" parent="1" source="G65QBH3iloMr4Mf4ziV6-129" target="G65QBH3iloMr4Mf4ziV6-134">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-129" value="+" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Courier New;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-130" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Courier New;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-131" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;" edge="1" parent="1" source="G65QBH3iloMr4Mf4ziV6-133" target="G65QBH3iloMr4Mf4ziV6-129">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-132" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;" edge="1" parent="1" source="G65QBH3iloMr4Mf4ziV6-133" target="G65QBH3iloMr4Mf4ziV6-135">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-133" value="*" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Courier New;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-134" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Courier New;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-135" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Courier New;fontSize=32;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-136" value="例えば (2 + 3) * 4 の場合は&lt;div&gt;上記の木構造に変化する。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="640" y="240" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-146" value="バイトコードの実行" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=32;fontStyle=4" vertex="1" parent="1">
          <mxGeometry y="1800" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-147" value="バイトコードは単純に&lt;div&gt;上から順に実行するだけ。&lt;/div&gt;&lt;div&gt;（優先順位等は&lt;/div&gt;&lt;div&gt;　出力時に考慮済みなので）&lt;/div&gt;&lt;div&gt;PUSHはスタックに&lt;/div&gt;&lt;div&gt;指定された値を積む処理。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="2079" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-148" value="１．" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=0" vertex="1" parent="1">
          <mxGeometry y="1829" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-151" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;[STACK]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;2&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="160" y="1879" width="80" height="200" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-152" value="&lt;font&gt;[CODE]&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;PUSH 2&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;PUSH 3&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;PUSH 4&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;MUL&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;ADD&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="40" y="1879" width="80" height="200" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-153" value="&lt;div&gt;スタックはLIFO(Last In, First Out：後入れ先出し)。&lt;/div&gt;&lt;div&gt;上に積まれているものしか&lt;/div&gt;&lt;div&gt;取り出すことはできない。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="400" y="2079" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-154" value="２．" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="360" y="1829" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-155" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;[STACK]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;3&lt;/font&gt;&lt;/div&gt;&lt;div&gt;2&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="1879" width="80" height="200" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-156" value="&lt;font&gt;[CODE]&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;PUSH 2&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;PUSH 3&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;PUSH 4&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;MUL&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;ADD&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="400" y="1879" width="80" height="200" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-157" value="&lt;div&gt;スタックには値しか格納&lt;/div&gt;&lt;div&gt;されない&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;演算エラー時はエラーを&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;示す値が格納される。&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="760" y="2079" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-158" value="３．" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="720" y="1829" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-159" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;[STACK]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;4&lt;/font&gt;&lt;/div&gt;&lt;div&gt;3&lt;/div&gt;&lt;div&gt;2&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="880" y="1879" width="80" height="200" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-160" value="&lt;font&gt;[CODE]&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;PUSH 2&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;PUSH 3&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;&lt;span&gt;PUSH 4&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;MUL&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;ADD&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="760" y="1879" width="80" height="200" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-161" value="&lt;div&gt;演算はスタックの上から&lt;/div&gt;&lt;div&gt;２つの値を取り出して、&lt;/div&gt;&lt;div&gt;その値で計算を行い、&lt;/div&gt;&lt;div&gt;演算結果を積みなおす。&lt;/div&gt;&lt;div&gt;ここでは 4 * 3 = 12 を積む。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="1125" y="2079" width="315" height="170" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-162" value="４．" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="1085" y="1829" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-163" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;[STACK]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;12&lt;/font&gt;&lt;/div&gt;&lt;div&gt;2&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="1245" y="1879" width="80" height="200" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-164" value="&lt;font&gt;[CODE]&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;PUSH 2&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;PUSH 3&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;PUSH 4&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;MUL&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;ADD&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="1125" y="1879" width="80" height="200" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-165" value="&lt;div&gt;加算も同様。&lt;/div&gt;&lt;div&gt;ここでは 2 + 12 = 14 を積む。&lt;/div&gt;&lt;div&gt;最後にスタックにはひとつの&lt;/div&gt;&lt;div&gt;値だけが残り、それが式の&lt;/div&gt;&lt;div&gt;評価結果となる。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="2560" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-166" value="５．" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=0" vertex="1" parent="1">
          <mxGeometry y="2310" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-167" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;[STACK]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#0000ff&quot;&gt;14&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="160" y="2360" width="80" height="200" as="geometry" />
        </mxCell>
        <mxCell id="G65QBH3iloMr4Mf4ziV6-168" value="&lt;font&gt;[CODE]&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;PUSH 2&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;PUSH 3&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;PUSH 4&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 204, 204);&quot;&gt;MUL&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;ADD&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=16;strokeColor=default;spacing=2;spacingLeft=2;fontColor=default;" vertex="1" parent="1">
          <mxGeometry x="40" y="2360" width="80" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
