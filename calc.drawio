        </mxCell>
        <mxCell id="cWpNXe89lP9ocWQLXMfx-135" value="演算実行時のセンサの値を&lt;div&gt;テーブルとして渡す必要が&lt;/div&gt;&lt;div&gt;ある。&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;" vertex="1" parent="cWpNXe89lP9ocWQLXMfx-1">
