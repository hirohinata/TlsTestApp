        </mxCell>
        <mxCell id="cWpNXe89lP9ocWQLXMfx-134" value="バイトコードの実行" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=32;fontStyle=4" vertex="1" parent="cWpNXe89lP9ocWQLXMfx-1">
